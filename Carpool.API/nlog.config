<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true"
      internalLogLevel="Warn"
      internalLogFile="${basedir}/internal-nlog.txt">

  <extensions>
    <add assembly="NLog.Web.AspNetCore" />
  </extensions>

  <!-- Shared layout: timestamp | LEVEL | logger | correlation id (from the ILogger scope
       set by CorrelationIdMiddleware, spec §55/§59) | message, with any exception on
       its own lines. Request bodies, passwords and tokens are never logged (spec §60). -->
  <variable name="layout"
            value="${longdate} | ${level:uppercase=true:padding=-5} | ${logger:shortName=true} | corr=${scopeproperty:item=CorrelationId:whenEmpty=-} | ${message}${onexception:${newline}${exception:format=toString}}" />

  <targets>
    <target xsi:type="ColoredConsole" name="console" layout="${layout}" />

    <target xsi:type="File" name="file"
            fileName="${basedir}/logs/carpool-${date:format=yyyy-MM-dd}.log"
            layout="${layout}"
            maxArchiveDays="14"
            encoding="utf-8" />
  </targets>

  <!-- finalMinLevel (not minlevel + final) so that messages *below* the level are also
       stopped and do not fall through to the catch-all rule. Order matters (spec §56):
       the Lifetime and per-namespace rules must precede the broad Microsoft.* / *. -->
  <rules>
    <!-- Drop the AutoMapper (Lucky Penny) dev/test license notice. -->
    <logger name="LuckyPennySoftware.*" finalMinLevel="Error" writeTo="console,file" />

    <!-- Keep the host lifetime messages ("Now listening on ..."). -->
    <logger name="Microsoft.Hosting.Lifetime" finalMinLevel="Info" writeTo="console,file" />

    <!-- Quiet framework noise, including the EF Core SQL command echo. -->
    <logger name="Microsoft.*" finalMinLevel="Warn" writeTo="console,file" />
    <logger name="System.*" finalMinLevel="Warn" writeTo="console,file" />

    <!-- Our own code: Debug for development diagnostics (spec §58). -->
    <logger name="Carpool.*" finalMinLevel="Debug" writeTo="console,file" />

    <!-- Anything else. -->
    <logger name="*" minlevel="Info" writeTo="console,file" />
  </rules>
</nlog>
